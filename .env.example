# SwarmVault WebApp — Environment Template
# Copy to .env and fill in real values before deploying.
# DO NOT commit .env to version control.

# ─── Environment ────────────────────────────────────────────────────────────
environment=development
debug=false

# ─── Database ───────────────────────────────────────────────────────────────
database_url=postgresql+asyncpg://swarmvault:CHANGE_ME@localhost:5432/swarmvault

# ─── Authentication ─────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
secret_key=CHANGE_ME_MIN_32_CHARS
algorithm=HS256
access_token_expire_minutes=60
refresh_token_expire_days=30

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated origins. Never use "*" in production.
# cors_origins=https://app.example.com,https://admin.example.com

# ─── LLM Provider ───────────────────────────────────────────────────────────
llm_provider=anthropic
llm_model=claude-sonnet-4-5-20250929
llm_max_tokens=1024
llm_temperature=0.7
llm_timeout_seconds=30
llm_max_retries=2
llm_retry_backoff=1.0
anthropic_api_key=CHANGE_ME
openai_api_key=CHANGE_ME

# ─── Object Storage ─────────────────────────────────────────────────────────
# storage_backend=filesystem  (or: s3)
# storage_path=./storage
# s3_endpoint=
# s3_access_key=
# s3_secret_key=
# s3_bucket=swarmvault-uploads
# s3_region=us-east-1

# ─── Observability ──────────────────────────────────────────────────────────
log_level=INFO
enable_metrics=false
